# Hisobchi Go web — namuna. Nusxa oling: .env.local (git'ga tushmaydi).
# FAQAT public (publishable / anon) kalit. Service-role kalitini bu yerga HECH QACHON yozmang
# va hech qachon NEXT_PUBLIC_ prefiksi bilan e'lon qilmang — u brauzer bundle'iga tushadi.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY
# Email tasdiqlash va parol tiklash havolalari qaytadigan origin (Supabase Redirect URLs ro'yxatida bo'lsin).
# Bo'sh qoldirilsa — joriy origin ishlatiladi (lokal va Vercel preview uchun qulay).
NEXT_PUBLIC_SITE_URL=
