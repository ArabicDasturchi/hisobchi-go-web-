# Hisobchi Go — Environment Variables
# Bu faylni nusxalab .env nomiga o'zgartiring va haqiqiy qiymatlarni kiriting.
# Haqiqiy maxfiy kalitlarni git'ga push qilmang!

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# AI Parsing (server-side only)
AI_API_KEY=your-ai-api-key-here
AI_MODEL=gpt-4o

# App
APP_ENV=development
